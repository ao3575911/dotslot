{
 "id": "mode-markdown-codespan",
 "description": "Markdown: inside backticks no warning.",
 "op": "scan",
 "path": "a.md",
 "input": "Owner: `<./owner:____________>`\n",
 "expect": {
  "slots": [
   {
    "index": 1,
    "name": "owner",
    "kind": "named",
    "policy": null,
    "line": 1,
    "col": 8,
    "width": 18,
    "capacity": 12,
    "lines": 1,
    "value": null
   }
  ],
  "issues": []
 }
}
